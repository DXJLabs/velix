STARKNET_CHAIN_ID=SN_SEPOLIA
# Server-side private messaging backend. Never expose these as VITE_ variables.
VEIL_PROVER_URL=http://127.0.0.1:3000
VEIL_PROVER_MODE=local
VEIL_EXPERIMENTAL_DIRECT_PROVER=false
VEIL_DISCOVERY_URL=http://127.0.0.1:3000/api/indexer/messages
STARKNET_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_9
VEIL_PRIVACY_POOL_ADDRESS=0x03a91bc44040f4173f30f3233d3cb2510aa05a0b74c22a5ee8240a313a0c8de5
VEIL_CHANNEL_HELPER_ADDRESS=0x052390845931a0c8d4735246d853a1a514c3cbf88cb1714937284814c5e57b23
VEIL_PROVER_CONNECTION_TIMEOUT_MS=5000
VEIL_PROVER_JOB_TIMEOUT_MS=900000
VEIL_PROVER_TOTAL_TIMEOUT_MS=1200000
VEIL_PROVER_HEALTH_RETRIES=1
VEIL_PROVER_JOB_RETRIES=2
VEIL_PROVER_RETRY_BASE_MS=250
VEIL_PROVER_RETRY_MAX_MS=5000

# Server-only PostgreSQL connection string. Never expose as VITE_DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-only encrypted proof payload keyring.
# Each value must be a Base64-encoded 32-byte key.
VEIL_PROOF_PAYLOAD_ACTIVE_KEY_VERSION=v1
VEIL_PROOF_PAYLOAD_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
