STARKNET_CHAIN_ID=SN_SEPOLIA
# Server-side private messaging backend. Never expose these as VITE_ variables.
VEIL_PROVER_URL=http://127.0.0.1:3000
VEIL_PROVER_MODE=local
VEIL_EXPERIMENTAL_DIRECT_PROVER=false
VEIL_DISCOVERY_URL=http://127.0.0.1:3000/api/indexer/messages
STARKNET_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_9
VEIL_PRIVACY_POOL_ADDRESS=0x03a91bc44040f4173f30f3233d3cb2510aa05a0b74c22a5ee8240a313a0c8de5
VEIL_CHANNEL_HELPER_ADDRESS=0x052390845931a0c8d4735246d853a1a514c3cbf88cb1714937284814c5e57b23
VEIL_PROVER_CONNECTION_TIMEOUT_MS=5000
VEIL_PROVER_JOB_TIMEOUT_MS=900000
VEIL_PROVER_TOTAL_TIMEOUT_MS=1200000
VEIL_PROVER_HEALTH_RETRIES=1
VEIL_PROVER_JOB_RETRIES=2
VEIL_PROVER_RETRY_BASE_MS=250
VEIL_PROVER_RETRY_MAX_MS=5000

# Server-only PostgreSQL connection string. Never expose as VITE_DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-only encrypted proof payload keyring.
# Each value must be a Base64-encoded 32-byte key.
VEIL_PROOF_PAYLOAD_ACTIVE_KEY_VERSION=v1
VEIL_PROOF_PAYLOAD_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}

# Server-only HMAC secret for pseudonymous distributed rate-limit identities.
VEIL_RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Server-only HMAC secret for job-scoped proof authorization identities.
# Never expose this value as a VITE_ variable.
VEIL_PROOF_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Server-only proof queue and worker limits.
VEIL_PROOF_QUEUE_MAX_QUEUED_JOBS=100
VEIL_PROOF_QUEUE_MAX_RUNNING_JOBS=1
VEIL_PROOF_QUEUE_RECOVERY_BATCH_SIZE=50

# Server-only production proof worker identity and timing.
# Every concurrently running worker replica must use a different name.
VEIL_PROOF_WORKER_NAME=worker-1
VEIL_PROOF_WORKER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
VEIL_PROOF_WORKER_LEASE_MS=120000
VEIL_PROOF_WORKER_HEARTBEAT_MS=30000
VEIL_PROOF_WORKER_IDLE_MS=2000
VEIL_PROOF_WORKER_ERROR_MS=5000

# Manual real-message integration only. The fixture must be generated by
# the wallet/Official Privacy SDK; never place keys or plaintext in it.
VEIL_REAL_E2E_ACKNOWLEDGE=false
VEIL_REAL_MESSAGE_FIXTURE=/absolute/path/to/official-message-proof-fixture.json
